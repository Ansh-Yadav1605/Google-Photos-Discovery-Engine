# ==============================================================================
# Google Photos Discovery Engine — Environment Configuration (.env.example)
# ==============================================================================

# Groq LLM API Configuration (Llama 3.3 70B Versatile)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Application & API Server Settings
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Storage & Database Paths
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_ANALYSIS_DIR=./data/analysis
DATABASE_URL=sqlite:///./data/analysis/discovery.db

# Optional Live Source Credentials (Polite unauthenticated scraping works out-of-the-box)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=GooglePhotosResearchBot/1.0 (NextLeap Graduation Project)
YOUTUBE_API_KEY=
